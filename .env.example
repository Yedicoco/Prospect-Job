# Exemple uniquement : ne jamais renseigner de secrets dans ce fichier versionné.
# Le serveur ne charge pas .env automatiquement : exporter les variables.
YALLAH_ENABLE_LIVE=0
YALLAH_ADMIN_PASSWORD=
YALLAH_PUBLIC_URL=
# Site vitrine officiel inclus dans les messages B2B et B2C
YALLAH_SITE_WEB=https://yallahservices-one.vercel.app

# Email : domaine expéditeur validé chez Resend
RESEND_API_KEY=
YALLAH_FROM_EMAIL=

# WhatsApp Business : Meta Cloud API, modèle approuvé pour le canal marketing
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr
# Confirmer seulement après vérification du contrat du modèle décrit dans WEB_APP.md
WHATSAPP_TEMPLATE_REVIEWED=0

# Exploitation : mode production refuse le démarrage sans administrateur et URL HTTPS
YALLAH_ENV=development
YALLAH_AUTO_BACKUP=1

# Callbacks entrants : configurer leurs URL publiques chez les fournisseurs
RESEND_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
